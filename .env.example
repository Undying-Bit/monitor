# Telegram API credentials (from https://my.telegram.org)
API_ID=
API_HASH=

# Group/channel ID to monitor (negative number for groups/channels)
GROUP_ID=

# Session file name (without .session extension)
SESSION_NAME=monitor_session

# Reconnect tuning (more tolerant by default)
TELEGRAM_CATCHUP_OVERLAP_MESSAGES=20
TELEGRAM_TIMEOUT_SECONDS=20
TELEGRAM_REQUEST_RETRIES=10
TELEGRAM_CONNECTION_RETRIES=-1
TELEGRAM_RETRY_DELAY_SECONDS=5

# Local timezone for event normalization
LOCAL_TIMEZONE=America/Mexico_City

# Serial settings (comma-separated ports)
SERIAL_PORTS=COM3
SERIAL_BAUDRATE=9600
SERIAL_BYTESIZE=8
SERIAL_PARITY=N
SERIAL_STOPBITS=1
SERIAL_TIMEOUT_SECONDS=1.0
SERIAL_RECONNECT_DELAY_SECONDS=5.0
SERIAL_MAX_FRAME_BYTES=4096

# Station resolution threshold (0-100)
CONFIDENCE_RESOLVE_THRESHOLD=70
