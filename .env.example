# Telegram API credentials (from https://my.telegram.org)
API_ID=
API_HASH=

# Group/channel ID to monitor (negative number for groups/channels)
GROUP_ID=

# Session file name (without .session extension)
SESSION_NAME=monitor_session

# Reconnect tuning (more tolerant by default)
TELEGRAM_TIMEOUT_SECONDS=20
TELEGRAM_REQUEST_RETRIES=10
TELEGRAM_CONNECTION_RETRIES=-1
TELEGRAM_RETRY_DELAY_SECONDS=5
